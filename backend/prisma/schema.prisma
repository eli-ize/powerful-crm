// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// User Management & Authentication
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  role      UserRole @default(SALES_REP)
  avatar    String?
  company   String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastLogin DateTime?

  // Permissions
  permissions Json // Store permissions object as JSON

  // Relationships
  contacts        Contact[]
  deals           Deal[]
  activities      Activity[]
  campaigns       Campaign[]
  virtualAgents   VirtualAgent[]
  callLogs        CallLog[]
  emailTemplates  EmailTemplate[]
  notes           Note[]
  tasks           Task[]
  refreshTokens   RefreshToken[]
  auditLogs       AuditLog[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  SALES_REP
  VIEWER
}

// CRM Core Entities
model Contact {
  id          String        @id @default(uuid())
  firstName   String
  lastName    String
  email       String?
  phone       String?
  title       String?
  company     String
  website     String?
  industry    String?
  location    String?
  source      String?
  status      ContactStatus @default(NEW)
  score       Int?          @default(0)
  tags        String[]
  customFields Json?        // Store dynamic custom fields
  
  // Lead qualification
  qualificationCategory String?
  qualificationReason   String?
  qualifiedAt          DateTime?
  
  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
  assignedTo String?

  // Relationships
  user       User         @relation(fields: [createdBy], references: [id])
  deals      Deal[]
  activities Activity[]
  callLogs   CallLog[]
  notes      Note[]
  tasks      Task[]
  campaignContacts CampaignContact[]

  @@map("contacts")
}

enum ContactStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  NEGOTIATING
  CLOSED_WON
  CLOSED_LOST
  NURTURING
  DEAD
}

model Deal {
  id          String     @id @default(uuid())
  title       String
  description String?
  value       Decimal?   @db.Decimal(10, 2)
  currency    String     @default("USD")
  stage       DealStage  @default(LEAD)
  probability Int?       @default(0)
  expectedCloseDate DateTime?
  actualCloseDate   DateTime?
  lostReason  String?
  
  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
  assignedTo String?

  // Relationships
  user       User         @relation(fields: [createdBy], references: [id])
  contact    Contact?     @relation(fields: [contactId], references: [id])
  contactId  String?
  activities Activity[]
  notes      Note[]
  tasks      Task[]

  @@map("deals")
}

enum DealStage {
  LEAD
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

// AI Campaign System
model Campaign {
  id          String         @id @default(uuid())
  name        String
  description String?
  type        CampaignType   @default(OUTBOUND_CALLING)
  status      CampaignStatus @default(DRAFT)
  
  // AI Configuration
  aiConfig    Json // Voice settings, personality, scripts, etc.
  
  // Campaign Rules
  rules       Json // Qualification criteria, actions, limits
  
  // Statistics
  stats       Json // Performance metrics
  
  // Scheduling
  startDate   DateTime?
  endDate     DateTime?
  
  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String

  // Relationships
  user             User                @relation(fields: [createdBy], references: [id])
  campaignContacts CampaignContact[]
  callLogs         CallLog[]
  activities       Activity[]

  @@map("campaigns")
}

enum CampaignType {
  OUTBOUND_CALLING
  EMAIL_SEQUENCE
  SMS_SEQUENCE
  MULTI_CHANNEL
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

model CampaignContact {
  id         String               @id @default(uuid())
  campaignId String
  contactId  String
  status     CampaignContactStatus @default(PENDING)
  stage      String               @default("new")
  priority   Int                  @default(0)
  attempts   Int                  @default(0)
  lastAttempt DateTime?
  nextAttempt DateTime?
  
  // Journey tracking
  journey    Json? // Track prospect journey through campaign
  
  // Metadata
  addedAt   DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  callLogs CallLog[]

  @@unique([campaignId, contactId])
  @@map("campaign_contacts")
}

enum CampaignContactStatus {
  PENDING
  IN_PROGRESS
  CONTACTED
  INTERESTED
  NOT_INTERESTED
  QUALIFIED
  DEAD
  COMPLETED
}

// AI Virtual Agents
model VirtualAgent {
  id          String            @id @default(uuid())
  name        String
  type        VirtualAgentType  @default(AI_CALLER)
  status      VirtualAgentStatus @default(IDLE)
  
  // Configuration
  config      Json // AI personality, voice, capabilities
  
  // Performance
  stats       Json // Call statistics, success rates, etc.
  
  // Current Activity
  currentActivity Json?
  
  // Work Schedule
  workingHours Json // Start time, end time, timezone, days
  
  // Assigned Campaigns
  assignedCampaigns String[] // Array of campaign IDs
  
  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String

  // Relationships
  user     User      @relation(fields: [createdBy], references: [id])
  callLogs CallLog[]

  @@map("virtual_agents")
}

enum VirtualAgentType {
  AI_CALLER
  AI_QUALIFIER
  AI_RESEARCHER
  AI_EMAILER
}

enum VirtualAgentStatus {
  ACTIVE
  IDLE
  CALLING
  RESEARCHING
  PAUSED
  OFFLINE
}

// Communication & Activities
model CallLog {
  id          String     @id @default(uuid())
  telnyxCallId String?   @unique
  direction   CallDirection @default(OUTBOUND)
  status      CallStatus @default(INITIATED)
  
  // Participants
  fromNumber  String
  toNumber    String
  contactId   String?
  
  // Call Details
  startedAt   DateTime?
  answeredAt  DateTime?
  endedAt     DateTime?
  duration    Int?      // seconds
  
  // AI Processing
  transcript  String?   // Full conversation transcript
  summary     String?   // AI-generated summary
  sentiment   String?   // positive, negative, neutral
  insights    Json?     // AI analysis results
  
  // Actions
  outcome     String?   // interested, not_interested, callback, etc.
  nextAction  String?   // schedule_meeting, send_email, etc.
  
  // Files
  recordingUrl String?
  
  // Campaign Context
  campaignId  String?
  agentId     String?   // Virtual agent ID
  
  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String

  // Relationships
  user            User             @relation(fields: [createdBy], references: [id])
  contact         Contact?         @relation(fields: [contactId], references: [id])
  campaign        Campaign?        @relation(fields: [campaignId], references: [id])
  virtualAgent    VirtualAgent?    @relation(fields: [agentId], references: [id])
  campaignContact CampaignContact? @relation(fields: [campaignContactId], references: [id])
  campaignContactId String?

  @@map("call_logs")
}

enum CallDirection {
  INBOUND
  OUTBOUND
}

enum CallStatus {
  INITIATED
  RINGING
  ANSWERED
  NO_ANSWER
  BUSY
  FAILED
  COMPLETED
}

model Activity {
  id          String       @id @default(uuid())
  type        ActivityType
  title       String
  description String?
  
  // Context
  contactId   String?
  dealId      String?
  campaignId  String?
  
  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String

  // Relationships
  user     User      @relation(fields: [createdBy], references: [id])
  contact  Contact?  @relation(fields: [contactId], references: [id])
  deal     Deal?     @relation(fields: [dealId], references: [id])
  campaign Campaign? @relation(fields: [campaignId], references: [id])

  @@map("activities")
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  NOTE
  TASK
  SMS
  WEBSITE_VISIT
  DOCUMENT_VIEW
  CAMPAIGN_ACTION
}

// Email & Templates
model EmailTemplate {
  id          String @id @default(uuid())
  name        String
  subject     String
  body        String // HTML content
  category    String?
  isShared    Boolean @default(false)
  
  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String

  // Relationships
  user User @relation(fields: [createdBy], references: [id])

  @@map("email_templates")
}

// Notes & Tasks
model Note {
  id        String @id @default(uuid())
  content   String
  isPrivate Boolean @default(false)
  
  // Context
  contactId String?
  dealId    String?
  
  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String

  // Relationships
  user    User     @relation(fields: [createdBy], references: [id])
  contact Contact? @relation(fields: [contactId], references: [id])
  deal    Deal?    @relation(fields: [dealId], references: [id])

  @@map("notes")
}

model Task {
  id          String     @id @default(uuid())
  title       String
  description String?
  status      TaskStatus @default(PENDING)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  completedAt DateTime?
  
  // Context
  contactId String?
  dealId    String?
  
  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
  assignedTo String?

  // Relationships
  user    User     @relation(fields: [createdBy], references: [id])
  contact Contact? @relation(fields: [contactId], references: [id])
  deal    Deal?    @relation(fields: [dealId], references: [id])

  @@map("tasks")
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// Audit & Compliance
model AuditLog {
  id        String   @id @default(uuid())
  action    String   // CREATE, UPDATE, DELETE, LOGIN, etc.
  resource  String   // contacts, deals, campaigns, etc.
  resourceId String?
  oldData   Json?
  newData   Json?
  ipAddress String?
  userAgent String?
  
  // Metadata
  createdAt DateTime @default(now())
  userId    String

  // Relationships
  user User @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

// System Configuration
model SystemConfig {
  id    String @id @default(uuid())
  key   String @unique
  value Json
  
  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_config")
}

// Job Queue (for background processing)
model Job {
  id        String    @id @default(uuid())
  type      String    // ai_call, email_send, data_enrichment, etc.
  data      Json      // Job payload
  status    JobStatus @default(PENDING)
  priority  Int       @default(0)
  attempts  Int       @default(0)
  maxAttempts Int     @default(3)
  error     String?
  result    Json?
  
  // Scheduling
  scheduledAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  
  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("jobs")
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}