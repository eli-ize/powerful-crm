// Database Configuration
// Currently using Azure SQL Server (Europe) - 150-180ms latency
// Recommended: Migrate to Azure PostgreSQL (Johannesburg) for 5-15ms latency
// See AZURE_POSTGRESQL_SA.md for migration guide

generator client {
  provider = "prisma-client-js"
}

generator erd {
  provider = "prisma-erd-generator"
  output   = "./Prisma_Database_ERD.png"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// User Management & Authentication
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("SALES_REP") // SUPER_ADMIN, ADMIN, MANAGER, SALES_REP, VIEWER
  avatar    String?
  company   String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastLogin DateTime?

  // Permissions stored as JSON string
  permissions String @default("{}")

  // Relationships
  contacts        Contact[]
  deals           Deal[]
  activities      Activity[]
  campaigns       Campaign[]
  virtualAgents   VirtualAgent[]
  callLogs        CallLog[]
  emailTemplates  EmailTemplate[]
  notes           Note[]
  tasks           Task[]
  refreshTokens   RefreshToken[]
  auditLogs       AuditLog[]
  userConfig      UserConfig?
  autopilotConfigs AutopilotConfig[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// CRM Core Entities
model Contact {
  id          String   @id @default(uuid())
  firstName   String
  lastName    String
  email       String?
  phone       String?
  title       String?
  company     String
  website     String?
  industry    String?
  location    String?
  source      String?
  status      String   @default("NEW") // NEW, CONTACTED, QUALIFIED, etc.
  score       Int?     @default(0)
  tags        String?  // Comma-separated tags
  customFields String? // JSON string
  
  // Google Places Lead Finder integration
  placeId     String?  // Google Place ID for deduplication
  
  // Lead qualification
  qualificationCategory String?
  qualificationReason   String?
  qualifiedAt          DateTime?
  
  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
  assignedTo String?

  // Relationships
  user       User         @relation(fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  deals      Deal[]
  activities Activity[]
  callLogs   CallLog[]
  notes      Note[]
  tasks      Task[]
  campaignContacts CampaignContact[]

  @@unique([placeId], name: "unique_place_id")
  @@index([company, phone], name: "idx_company_phone")
  @@index([company, email], name: "idx_company_email")
  @@map("contacts")
}

model Deal {
  id          String     @id @default(uuid())
  title       String
  description String?
  value       Float?
  currency    String     @default("USD")
  stage       String     @default("LEAD") // LEAD, QUALIFIED, PROPOSAL, etc.
  probability Int?       @default(0)
  expectedCloseDate DateTime?
  actualCloseDate   DateTime?
  lostReason  String?
  
  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
  assignedTo String?

  // Relationships
  user       User         @relation(fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  contact    Contact?     @relation(fields: [contactId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  contactId  String?
  activities Activity[]
  notes      Note[]
  tasks      Task[]

  @@map("deals")
}

// AI Campaign System
model Campaign {
  id          String         @id @default(uuid())
  name        String
  description String?
  type        String         @default("OUTBOUND_CALLING") // OUTBOUND_CALLING, EMAIL_SEQUENCE, etc.
  status      String         @default("DRAFT") // DRAFT, ACTIVE, PAUSED, COMPLETED, CANCELLED
  
  // AI Configuration stored as JSON string
  aiConfig    String @default("{}")
  
  // Campaign Rules stored as JSON string
  rules       String @default("{}")
  
  // Statistics stored as JSON string
  stats       String @default("{}")
  
  // Scheduling
  startDate   DateTime?
  endDate     DateTime?
  
  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String

  // Relationships
  user             User                @relation(fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  campaignContacts CampaignContact[]
  callLogs         CallLog[]
  activities       Activity[]

  @@map("campaigns")
}

model CampaignContact {
  id         String    @id @default(uuid())
  campaignId String
  contactId  String
  status     String    @default("PENDING") // PENDING, IN_PROGRESS, CONTACTED, etc.
  stage      String    @default("new")
  priority   Int       @default(0)
  attempts   Int       @default(0)
  lastAttempt DateTime?
  nextAttempt DateTime?
  
  // Journey tracking stored as JSON string
  journey    String?
  
  // Metadata
  addedAt   DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  callLogs CallLog[]

  @@unique([campaignId, contactId])
  @@map("campaign_contacts")
}

// AI Virtual Agents
model VirtualAgent {
  id          String   @id @default(uuid())
  name        String
  type        String   @default("AI_CALLER") // AI_CALLER, AI_QUALIFIER, etc.
  status      String   @default("IDLE") // ACTIVE, IDLE, CALLING, etc.
  
  // Configuration stored as JSON string
  config      String @default("{}")
  
  // Performance stored as JSON string
  stats       String @default("{}")
  
  // Current Activity stored as JSON string
  currentActivity String?
  
  // Work Schedule stored as JSON string
  workingHours String @default("{}")
  
  // Assigned Campaigns stored as comma-separated IDs
  assignedCampaigns String?
  
  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String

  // Relationships
  user     User      @relation(fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  callLogs CallLog[]

  @@map("virtual_agents")
}

// Communication & Activities
model CallLog {
  id          String     @id @default(uuid())
  telnyxCallId String?   @unique
  direction   String     @default("OUTBOUND") // INBOUND, OUTBOUND
  status      String     @default("INITIATED") // INITIATED, RINGING, ANSWERED, etc.
  
  // Participants
  fromNumber  String
  toNumber    String
  contactId   String?
  
  // Call Details
  startedAt   DateTime?
  answeredAt  DateTime?
  endedAt     DateTime?
  duration    Int?      // seconds
  
  // AI Processing
  transcript  String?
  summary     String?
  sentiment   String?   // positive, negative, neutral
  insights    String?   // JSON string
  
  // Actions
  outcome     String?   // interested, not_interested, callback, etc.
  nextAction  String?   // schedule_meeting, send_email, etc.
  
  // Files
  recordingUrl String?
  
  // Campaign Context
  campaignId  String?
  agentId     String?   // Virtual agent ID
  
  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String

  // Relationships
  user            User             @relation(fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  contact         Contact?         @relation(fields: [contactId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  campaign        Campaign?        @relation(fields: [campaignId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  virtualAgent    VirtualAgent?    @relation(fields: [agentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  campaignContact CampaignContact? @relation(fields: [campaignContactId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  campaignContactId String?

  @@map("call_logs")
}

model Activity {
  id          String   @id @default(uuid())
  type        String   // CALL, EMAIL, MEETING, NOTE, etc.
  title       String
  description String?
  
  // Context
  contactId   String?
  dealId      String?
  campaignId  String?
  
  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String

  // Relationships
  user     User      @relation(fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  contact  Contact?  @relation(fields: [contactId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  deal     Deal?     @relation(fields: [dealId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("activities")
}

// Email & Templates
model EmailTemplate {
  id          String @id @default(uuid())
  name        String
  subject     String
  body        String // HTML content
  category    String?
  isShared    Boolean @default(false)
  
  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String

  // Relationships
  user User @relation(fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("email_templates")
}

// Notes & Tasks
model Note {
  id        String @id @default(uuid())
  content   String
  isPrivate Boolean @default(false)
  
  // Context
  contactId String?
  dealId    String?
  
  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String

  // Relationships
  user    User     @relation(fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  deal    Deal?    @relation(fields: [dealId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("notes")
}

model Task {
  id          String     @id @default(uuid())
  title       String
  description String?
  status      String     @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, CANCELLED
  priority    String     @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  dueDate     DateTime?
  completedAt DateTime?
  
  // Context
  contactId String?
  dealId    String?
  
  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
  assignedTo String?

  // Relationships
  user    User     @relation(fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  deal    Deal?    @relation(fields: [dealId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("tasks")
}

// Audit & Compliance
model AuditLog {
  id        String   @id @default(uuid())
  action    String   // CREATE, UPDATE, DELETE, LOGIN, etc.
  resource  String   // contacts, deals, campaigns, etc.
  resourceId String?
  oldData   String?  // JSON string
  newData   String?  // JSON string
  ipAddress String?
  userAgent String?
  
  // Metadata
  createdAt DateTime @default(now())
  userId    String

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("audit_logs")
}

// System Configuration
model SystemConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String // Encrypted value or JSON string
  category  String?  // e.g., 'api_key', 'setting', 'feature_flag'
  encrypted Boolean  @default(true)
  
  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_config")
}

// User Configuration for API usage limits
model UserConfig {
  id                    String @id @default(uuid())
  userId                String @unique
  dailySpendingLimit    Float? @default(10.0)
  monthlySpendingLimit  Float? @default(100.0)
  perCallLimit          Float? @default(2.0)
  maxCallDuration       Int?   @default(300) // seconds
  
  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_config")
}

// API Usage tracking for cost monitoring
model ApiUsage {
  id        String   @id @default(uuid())
  service   String   // openai, azure_speech, telnyx
  operation String   // call, transcribe, synthesize, etc.
  cost      Float
  metadata  String?  // JSON string for additional details
  userId    String?
  
  // Metadata
  createdAt DateTime @default(now())

  @@map("api_usage")
}

// Job Queue (for background processing)
model Job {
  id        String    @id @default(uuid())
  type      String    // ai_call, email_send, data_enrichment, etc.
  data      String    // JSON string
  status    String @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED, CANCELLED
  priority  Int       @default(0)
  attempts  Int       @default(0)
  maxAttempts Int     @default(3)
  error     String?
  result    String?   // JSON string
  
  // Scheduling
  scheduledAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  
  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("jobs")
}

// AI Autopilot System
model AutopilotConfig {
  id          String  @id @default(uuid())
  userId      String
  name        String  @default("Default Autopilot")
  industry    String  @default("web_design")
  isActive    Boolean @default(false)
  
  // Configuration stored as JSON
  config      String  @default("{}")
  
  // Performance metrics
  totalLeadsFound    Int @default(0)
  totalCallsMade     Int @default(0)
  totalMeetingsBooked Int @default(0)
  totalRevenue       Float @default(0)
  
  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks AutopilotTask[]
  workflows AutopilotWorkflow[]

  @@map("autopilot_configs")
}

model AutopilotTask {
  id          String    @id @default(uuid())
  configId    String
  type        String    // find_leads, analyze_website, make_calls, assign_designer, send_emails
  status      String    @default("pending") // pending, in_progress, completed, failed
  progress    Int       @default(0)
  
  // Task data
  inputData   String?   // JSON string
  resultData  String?   // JSON string
  errorMessage String?
  
  // Assignment
  assignedTo  String?   // For designer tasks
  
  // Timing
  startedAt   DateTime?
  completedAt DateTime?
  
  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relationships
  config AutopilotConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@map("autopilot_tasks")
}

model AutopilotWorkflow {
  id          String @id @default(uuid())
  configId    String
  name        String
  description String?
  
  // Workflow definition
  steps       String // JSON array of steps
  currentStep Int    @default(0)
  status      String @default("pending") // pending, running, completed, failed, paused
  
  // Results
  totalSteps  Int    @default(0)
  progress    Int    @default(0)
  resultData  String? // JSON string
  
  // Timing
  startedAt   DateTime?
  completedAt DateTime?
  
  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relationships
  config AutopilotConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@map("autopilot_workflows")
}
