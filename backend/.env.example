# Environment Variables for Powerful CRM Backend

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/powerfulcrm"

# JWT Secrets (Generate strong secrets in production)
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-long"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-min-32-chars-long"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Redis (for caching and job queues)
REDIS_URL="redis://localhost:6379"

# API Keys - External Services
GOOGLE_PLACES_API_KEY="AIza..."
TELNYX_API_KEY="KEY..."
TELNYX_PUBLIC_KEY="KEY..."
AZURE_SPEECH_KEY="your-azure-speech-key"
AZURE_SPEECH_REGION="eastus"
OPENAI_API_KEY="sk-..."

# Email Configuration (Optional - for notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
EMAIL_FROM="noreply@yourcrm.com"

# Application Configuration
NODE_ENV="development"
PORT="8000"
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:8000"

# File Storage (for recordings, exports, etc.)
STORAGE_TYPE="local" # local, s3, azure, gcs
AWS_S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION=""

# Stripe (for subscription billing)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Logging
LOG_LEVEL="info"
LOG_FILE="logs/app.log"

# Rate Limiting
RATE_LIMIT_WINDOW_MS="900000" # 15 minutes
RATE_LIMIT_MAX_REQUESTS="100"

# Production Security
CORS_ORIGIN="http://localhost:3000"
TRUST_PROXY="false"