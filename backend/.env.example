# ===================================
# POWERFUL CRM - SOUTH AFRICA OPTIMIZED STACK
# ===================================

# ===================================
# DATABASE - Supabase (Cape Town, SA)
# ===================================
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-af-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DATABASE_PROVIDER="supabase"

# Local development (use Docker PostgreSQL or Supabase local):
# DATABASE_URL="postgresql://postgres:password@localhost:5432/powerfulcrm"

# ===================================
# JWT SECRETS
# ===================================
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-long"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-min-32-chars-long"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ===================================
# REDIS CACHE - Upstash (Cape Town, SA)
# ===================================
# Get free account: https://upstash.com (choose Cape Town region)
REDIS_URL="redis://default:[PASSWORD]@sa-cape-town-12345.upstash.io:6379"
# Or local: REDIS_URL="redis://localhost:6379"

# ===================================
# TELNYX - Telephony (Europe edge, closest to SA)
# ===================================
TELNYX_API_KEY="KEY..."
TELNYX_PUBLIC_KEY="PUBLIC_KEY..."
TELNYX_CONNECTION_ID="..."
TELNYX_PREFERRED_REGION="europe"  # Amsterdam edge (closest to SA)

# ===================================
# AI - GROQ (Cheapest & Fastest LLM)
# ===================================
# Get free key: https://console.groq.com
# Cost: $0.59/1M tokens (10x cheaper than GPT-4)
# Speed: 50-150ms inference
GROQ_API_KEY="gsk_..."

# ===================================
# TTS - Azure Speech (Johannesburg, SA)
# ===================================
# Azure Portal → Create Speech Service → Region: "South Africa North"
# Voices: en-ZA-LeahNeural (Female), en-ZA-LukeNeural (Male)
AZURE_SPEECH_KEY="your-azure-speech-key"
AZURE_SPEECH_REGION="southafricanorth"  # Johannesburg datacenter

# ===================================
# OPTIONAL: Fallback AI Providers
# ===================================
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-ant-..."
ELEVENLABS_API_KEY="..."  # Premium TTS alternative

AZURE_OPENAI_KEY="your-azure-openai-key"
AZURE_OPENAI_ENDPOINT="https://your-resource.openai.azure.com/"
AZURE_OPENAI_DEPLOYMENT="gpt-4"
AZURE_OPENAI_API_VERSION="2024-02-15-preview"

# ===================================
# OTHER APIS
# ===================================
GOOGLE_PLACES_API_KEY="AIza..."

# ===================================
# SERVER CONFIG
# ===================================
NODE_ENV="development"
PORT="8000"
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:8000"
WEBHOOK_URL="http://localhost:8000/webhooks"

# Production (Render + Vercel):
# NODE_ENV="production"
# FRONTEND_URL="https://powerful-crm.vercel.app"
# BACKEND_URL="https://powerful-crm-backend.onrender.com"
# WEBHOOK_URL="https://powerful-crm-backend.onrender.com/webhooks"

# ===================================
# EMAIL (Optional)
# ===================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
EMAIL_FROM="noreply@powerfulcrm.com"

# ===================================
# STORAGE (Optional)
# ===================================
STORAGE_TYPE="local"  # local, s3, azure, gcs
AWS_S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="af-south-1"  # Cape Town

# ===================================
# STRIPE (Optional)
# ===================================
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ===================================
# SECURITY
# ===================================
CORS_ORIGIN="http://localhost:3000"
TRUST_PROXY="false"
RATE_LIMIT_WINDOW_MS="900000"  # 15 minutes
RATE_LIMIT_MAX_REQUESTS="100"

# Production:
# CORS_ORIGIN="https://powerful-crm.vercel.app"
# TRUST_PROXY="true"

# ===================================
# LOGGING
# ===================================
LOG_LEVEL="info"
LOG_FILE="logs/app.log"

# ===================================
# SOUTH AFRICA STACK SUMMARY
# ===================================
# ✅ Database: Supabase (Cape Town) - $0-25/month
# ✅ TTS: Azure Speech (Johannesburg) - $1-3/month
# ✅ AI: Groq (US West) - $0-10/month
# ✅ Backend: Render (Cape Town) - $7-25/month
# ✅ Frontend: Vercel (Global CDN) - $0-20/month
# ✅ Cache: Upstash Redis (Cape Town) - $0-5/month
# ✅ Telephony: Telnyx (Amsterdam → SA) - $5-15/month
#
# Total: $13-103/month (vs $295+ Azure stack)
# Savings: 80-95% cost reduction
# Latency: 5-15ms for SA users (vs 150-400ms)
#
# See: DEPLOY_SOUTH_AFRICA.md for complete setup guide