# Azure FREE Tier Environment Configuration
# Copy these values to your application's environment variables

# ========================================
# AZURE SERVICES (ALL FREE TIER)
# ========================================

# Azure Speech Services (FREE: 5K TTS chars, 5 hours STT/month)
AZURE_SPEECH_KEY=your_speech_key_here
AZURE_SPEECH_REGION=eastus

# Azure OpenAI Service (Pay-per-use, start ~$10/month)
AZURE_OPENAI_KEY=your_azure_openai_key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# Azure Application Insights (FREE: 5GB data/month)
APPINSIGHTS_INSTRUMENTATIONKEY=your_insights_key

# Azure Storage (FREE: 5GB blob storage)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your_account;AccountKey=your_key;EndpointSuffix=core.windows.net

# ========================================
# DATABASE & CACHE (FREE TIER)
# ========================================

# Azure Database for PostgreSQL (FREE: 250MB storage)
DATABASE_URL=postgresql://dbadmin:your_password@your-server.postgres.database.azure.com:5432/crmdb

# Azure Cache for Redis (FREE: 250MB cache)
REDIS_URL=rediss://:your_password@your-cache.redis.cache.windows.net:6380

# ========================================
# EXTERNAL APIs (OPTIONAL)
# ========================================

# Google Places API (FREE: $200 credit/month)
GOOGLE_PLACES_API_KEY=AIzaSyD...

# Telnyx Telephony (~$5/month for phone + calls)
TELNYX_API_KEY=KEY...
TELNYX_PHONE_NUMBER=+15551234567

# Hunter.io Email Finder (FREE: 25 searches/month)
HUNTER_API_KEY=your_hunter_key

# ========================================
# APPLICATION CONFIGURATION
# ========================================

# Deployment URLs (auto-generated by script)
FRONTEND_URL=https://your-app.azurestaticapps.net
BACKEND_URL=https://your-app.azurecontainerapps.io

# Environment
NODE_ENV=production

# JWT Secrets (generate your own)
JWT_SECRET=your_super_secure_jwt_secret_minimum_32_characters
JWT_REFRESH_SECRET=your_super_secure_refresh_secret_minimum_32_characters

# ========================================
# COST MONITORING
# ========================================

# Set up budget alerts in Azure Portal
# Recommended: $10/month budget with alerts at $8

# ========================================
# FREE TIER LIMITS
# ========================================

# Container Apps: 2M requests/month
# Static Web Apps: Unlimited hosting
# PostgreSQL: 250MB storage
# Redis: 250MB cache
# Speech: 5K TTS chars, 5 hours STT
# Storage: 5GB blob storage
# App Insights: 5GB data ingestion

# Typical usage stays within FREE limits for:
# - Up to 100 concurrent users
# - 1,000 AI calls/month
# - Full CRM functionality
# - Real-time updates

# Expected cost: $0-15/month
# (vs $200+ on other platforms)