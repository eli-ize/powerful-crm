# ===================================
# FRONTEND - ENVIRONMENT VARIABLES
# ===================================

# ===================================
# API URL (Backend)
# ===================================
# Development (local backend):
VITE_API_URL="http://localhost:8000"

# Production (Render Cape Town):
# VITE_API_URL="https://powerful-crm-backend.onrender.com"

# ===================================
# TELNYX (Telephony - Frontend)
# ===================================
VITE_TELNYX_PUBLIC_KEY="PUBLIC_KEY..."

# ===================================
# APPLICATION CONFIG
# ===================================
VITE_APP_NAME="Powerful CRM"
VITE_APP_VERSION="1.0.0"
VITE_ENVIRONMENT="development"

# Production:
# VITE_ENVIRONMENT="production"

# ===================================
# FEATURE FLAGS
# ===================================
VITE_ENABLE_AI_CALLING="true"
VITE_ENABLE_LEAD_FINDER="true"
VITE_ENABLE_VIRTUAL_AGENTS="true"

# ===================================
# EXTERNAL SERVICES (Optional)
# ===================================
VITE_GOOGLE_MAPS_API_KEY=""
VITE_SENTRY_DSN=""
VITE_ANALYTICS_ID=""

# ===================================
# DEVELOPMENT
# ===================================
VITE_DEBUG_MODE="true"

# ===================================
# SOUTH AFRICA STACK NOTES
# ===================================
# Frontend deployed to Vercel (Global CDN with Cape Town edge)
# Backend API hosted on Render (Cape Town datacenter)
# Expected latency: 5-15ms for SA users
# See: DEPLOY_SOUTH_AFRICA.md for deployment guide