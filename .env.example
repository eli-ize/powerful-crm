# Environment Variables for Frontend

# API Configuration
VITE_API_URL=http://localhost:8000

# Application Configuration
VITE_APP_NAME="Powerful CRM"
VITE_APP_VERSION="1.0.0"

# Feature Flags
VITE_ENABLE_AI_CALLING=true
VITE_ENABLE_LEAD_FINDER=true
VITE_ENABLE_VIRTUAL_AGENTS=true

# External Services (Frontend)
VITE_GOOGLE_MAPS_API_KEY=""
VITE_SENTRY_DSN=""
VITE_ANALYTICS_ID=""

# Development
VITE_DEBUG_MODE=true